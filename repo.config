# Repository configuration read by tools/gate.sh.
#
# One `app` block per application in this monorepo. Add a block when you add an app; the gate
# discovers apps from this file rather than by scanning the filesystem, so an app that is not
# listed here is not gated — which is a deliberate, visible omission rather than a silent one.
#
# Fields per app:
#   path        repository-relative directory
#   enabled     true|false — false means the app is present but not yet gated
#   verify_cmd  command that proves the app RUNS, not merely builds (see AGENTS.md section 7).
#               It must start the app, probe its real HTTP surface, and exit non-zero on failure.
#               Example for a Next.js app: `bash scripts/verify.sh`
#   note        why it is disabled, or anything a reader needs

version: 1

# Each application appears here as it lands. The block MUST be added in the same commit that
# lands the app, or the app is not gated.
#
# apps:
#   - name: ameisenwerkstatt
#     path: apps/ameisenwerkstatt
#     enabled: true
#     verify_cmd: bash scripts/verify.sh
